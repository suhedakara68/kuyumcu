# Firebase Config örnek dosyası
# .env dosyasını oluşturup bu değerleri Firebase Console'dan alarak doldurun
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=kuyumcu-app.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://kuyumcu-app-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=kuyumcu-app
VITE_FIREBASE_STORAGE_BUCKET=kuyumcu-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
